WS_CORS_ORIGIN=true
# Optional ping tuning (milliseconds)
# WS_PING_TIMEOUT_MS=30000
# WS_PING_INTERVAL_MS=25000

# Android BDD template (android-login-flow.ts) environment variables
# Use launch mode (app installed):
# GTT_ANDROID_DEVICE_NAME=YOUR_DEVICE_NAME
# GTT_ANDROID_UDID=YOUR_DEVICE_UDID
# GTT_APP_PACKAGE=com.example.app
# GTT_APP_ACTIVITY=.MainActivity
# Or install mode (provide APK placed under workspace/app or APP_DIR):
# GTT_APK=your-app.apk

# Optional: aapt binary for APK package parsing (pre-uninstall)
# AAPT_BIN=/usr/local/bin/aapt

# Shared libs root overrides (optional)
# CORE_LIB_DIR=./workspace/shared-libs/core
# GETTR_LIB_DIR=./workspace/shared-libs/gettr-web
# GETTR_ANDROID_LIB_DIR=./workspace/shared-libs/gettr-android
# GETTR_MOBILE_WEB_LIB_DIR=./workspace/shared-libs/gettr-mobile-web
